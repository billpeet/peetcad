<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: it runs from a scheduled task in a desktop session and must not open a console window there. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>peet-sw-export</AssemblyName>
    <RootNamespace>PeetSwExport</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- Folder holding the SolidWorks interop assemblies (from a SolidWorks installation's api\redist).
         Machine-specific: set the SolidWorksInteropDir environment variable or pass -p:SolidWorksInteropDir=... -->
    <SolidWorksInteropDir Condition="'$(SolidWorksInteropDir)' == ''">C:\Users\marti\Downloads\</SolidWorksInteropDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksInteropDir)SolidWorks.Interop.sldworks.dll</HintPath>
      <Private>True</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksInteropDir)SolidWorks.Interop.swconst.dll</HintPath>
      <Private>True</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="RunInDesktopSession.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
